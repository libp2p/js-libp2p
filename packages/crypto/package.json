{
  "name": "@libp2p/crypto",
  "version": "5.1.25",
  "description": "Crypto primitives for libp2p",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/libp2p/js-libp2p/tree/main/packages/crypto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libp2p/js-libp2p.git"
  },
  "bugs": {
    "url": "https://github.com/libp2p/js-libp2p/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "IPFS",
    "crypto",
    "libp2p",
    "rsa",
    "secp256k1"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "*",
        "dist/*",
        "dist/src/*",
        "dist/src/*/index"
      ],
      "src/*": [
        "*",
        "dist/*",
        "dist/src/*",
        "dist/src/*/index"
      ]
    }
  },
  "files": [
    "src",
    "dist",
    "!dist/test",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "module-sync": "./dist/src/index.js"
    },
    "./der": {
      "types": "./dist/src/der.d.ts",
      "import": "./dist/src/der.js",
      "module-sync": "./dist/src/der.js"
    },
    "./pb": {
      "types": "./dist/src/pb.d.ts",
      "import": "./dist/src/pb.js",
      "module-sync": "./dist/src/pb.js"
    }
  },
  "scripts": {
    "clean": "aegir clean",
    "lint": "aegir lint",
    "dep-check": "aegir dep-check",
    "doc-check": "aegir doc-check",
    "build": "aegir build",
    "test": "aegir test",
    "test:chrome": "aegir test -t browser",
    "test:chrome-webworker": "aegir test -t webworker",
    "test:firefox": "aegir test -t browser -- --browser firefox",
    "test:firefox-webworker": "aegir test -t webworker -- --browser firefox",
    "test:webkit": "aegir test -t browser -- --browser webkit",
    "test:node": "aegir test -t node --cov",
    "test:electron-main": "aegir test -t electron-main",
    "generate": "protons src/**/*.proto"
  },
  "dependencies": {
    "abort-error": "^1.0.2",
    "multiformats": "^14.0.0",
    "protons-runtime": "^7.0.0",
    "uint8arraylist": "^3.0.2",
    "uint8arrays": "^6.1.1"
  },
  "devDependencies": {
    "@libp2p/interface": "^3.4.0",
    "@types/sinon": "^22.0.0",
    "aegir": "^48.0.4",
    "libp2p-crypto-v5": "npm:@libp2p/crypto@^5.1.25",
    "protons": "^9.0.1"
  },
  "sideEffects": false
}
